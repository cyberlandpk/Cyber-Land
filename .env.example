# Public site URL used for metadata, sitemap, and robots
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# WooCommerce / WordPress API Integration
# NOTE: Use the WordPress REST base URL (e.g. https://your-domain.com or https://your-domain.com/wp)
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-domain.com
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# Keep real credentials ONLY in .env.local (git-ignored) or your host's environment settings.
# Scripts that need credentials should be run with: node --env-file=.env.local scripts/<name>.js

